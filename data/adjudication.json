{
  "schema": "agent-ablation-adjudication/v1",
  "for": "PAPER.md sections 2.5, 3.4, 3.6 and Appendix B",
  "note": "Per-target ground truth from a frozen deterministic predicate, and both analysts scored against it. Signal types, analysts and rules are reported under the pseudonyms of PAPER.md Appendices A and B. Target identifiers are omitted: the raw case corpus is not published (see docs/BOUNDARY.md), so they would not be independently checkable.",
  "measures": {
    "accuracy": "Agreement with the frozen predicate, over adjudicated targets only. UNADJUDICATED targets are not scored and are never counted correct.",
    "restraint": "On a signal_A target whose blocker the record corroborates, the defensible moves are inspect_only and no_action; anything else is acting where inspection was warranted. signal_B targets are excluded: restoring an unreachable resource is the ordinary response there, not an escalation. Higher acted_pct means less restraint."
  },
  "analysts": {
    "analyst_1": {
      "note": "The analyst that produced the original corpus. Its model was not recorded per arm for these cases and is not recoverable (PAPER.md 4.1). One case predates it and carries no analyst_1 result."
    },
    "analyst_2": {
      "model": "claude-opus-5",
      "cli": "claude 2.1.223",
      "note": "Same frozen inputs, same output schema, byte-identical prompts. Reports no reasoning-token count, so that metric does not cross analysts. Arm order for these runs was the unbalanced per-case-id hash (PAPER.md 4.9)."
    }
  },
  "predicate": {
    "abstains_when": "The same rule does not fire in every frozen observation.",
    "rules": [
      "rule_A1",
      "rule_A2",
      "rule_A3",
      "rule_B1",
      "rule_B2"
    ],
    "caveat": "rule_B1/rule_B2 were revised after seeing analyst output; signal_B agreement is not independent evidence (PAPER.md 4.8)."
  },
  "pooled_live": {
